{
  "name": "laravel-vue-i18n",
  "version": "2.9.0",
  "author": {
    "name": "Francisco Madeira",
    "email": "xico2k@gmail.com"
  },
  "keywords": [
    "laravel",
    "vue",
    "vue3",
    "inertiajs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiCO2k/laravel-vue-i18n.git"
  },
  "license": "MIT",
  "description": "allows to connect your `Laravel` Framework localization files with `Vue`.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      },
      "require": {
        "types": "./dist/*.d.cts",
        "default": "./dist/*.cjs"
      },
      "types": "./dist/*.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "vite": [
        "dist/vite.d.ts"
      ],
      "*": [
        "dist/*",
        "dist/index.d.ts"
      ]
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node test/integration/run.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "coverage": "vitest run --coverage",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.{ts,mts,cts}\" \"test/integration/*.mjs\" \"scripts/*.mjs\" \"*.mts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,mts,cts}\" \"test/integration/*.mjs\" \"scripts/*.mjs\" \"*.mts\"",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "postpublish": "PACKAGE_VERSION=$(cat package.json | grep \\\"version\\\" | head -1 | awk -F: '{ print $2 }' | sed 's/[\",]//g' | tr -d '[[:space:]]') && git tag v$PACKAGE_VERSION && git push --tags"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "5.0.0",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "laravel-mix": "^6.0.49",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0",
    "webpack": "~5.99.9"
  },
  "dependencies": {
    "php-parser": "3.7.0",
    "vue": "^3.5.13"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --parser=typescript --write"
    ],
    "*.js": [
      "prettier --parser=javascript --write"
    ]
  },
  "type": "commonjs"
}
